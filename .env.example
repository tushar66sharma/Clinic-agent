# Edvak_forge configuration
# Copy this file to `.env` and fill in ONE provider's key.
# `.env` is git-ignored. Never commit real keys.
#
# Switching providers = change LLM_PROVIDER (and its key). No code changes.
# Supported values: groq | cerebras | openrouter | mistral | ollama
# Gemini is intentionally NOT supported (project rule).

LLM_PROVIDER=groq

# Optional overrides. Leave commented to use the provider's defaults (llm/providers.py).
# LLM_MODEL=            # model that analyses each message
# LLM_REPLY_MODEL=      # model that writes the reply (Groq default: openai/gpt-oss-20b)
# LLM_BASE_URL=

# --- Groq (recommended default) -----------------------------------------
# Free key: https://console.groq.com/keys  (no credit card)
# Defaults: openai/gpt-oss-120b (analysis), openai/gpt-oss-20b (replies)
# Free plan measured 2026-10-18: 1,000 requests/day, 8,000 tokens/minute PER MODEL
GROQ_API_KEY=your-groq-key-here

# --- Cerebras --------------------------------------------------------------
# Free trial key: https://cloud.cerebras.ai  (5 requests/min on free trial)
# Default model: gpt-oss-120b
CEREBRAS_API_KEY=

# --- OpenRouter ------------------------------------------------------------
# Key: https://openrouter.ai/keys  (":free" models: 20/min, 50/day without credits)
# Default model: a ":free" model id, set LLM_MODEL to choose one
OPENROUTER_API_KEY=

# --- Mistral ---------------------------------------------------------------
# Key: https://console.mistral.ai  (free "Experiment" tier, lowest limits)
MISTRAL_API_KEY=

# --- Ollama (local, no key, no rate limits) --------------------------------
# Install from https://ollama.com, then e.g. `ollama pull qwen3:14b`
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Reliability knobs ------------------------------------------------------
# Seconds before one LLM request is abandoned
LLM_TIMEOUT_SECONDS=60
# Retries on rate-limit (429) and server (5xx) errors, with exponential backoff
LLM_MAX_RETRIES=4
# Hard wall-clock limit for one AI call including retries; past it the message goes to a human
LLM_DEADLINE_SECONDS=240
# Client-side request throttle; leave commented to use the provider's safe default
# LLM_MAX_REQUESTS_PER_MINUTE=25
# Reuse saved model responses for identical requests (1) or always call the model (0)
LLM_CACHE=1

# --- Clinic simulation -----------------------------------------------------
# "Today" for all policy and scheduling logic (fixed by the brief)
CLINIC_TODAY=2026-11-09
